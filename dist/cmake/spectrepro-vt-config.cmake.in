@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(_spectrepro_vt_libdir "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@")

# Shared library target
if(NOT TARGET spectrepro-vt::spectrepro-vt)
    add_library(spectrepro-vt::spectrepro-vt SHARED IMPORTED)

    if(WIN32)
        set(_spectrepro_vt_shared_location "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/@SPECTREPRO_VT_REALNAME@")
    else()
        set(_spectrepro_vt_shared_location "${_spectrepro_vt_libdir}/@SPECTREPRO_VT_REALNAME@")
    endif()

    set_target_properties(spectrepro-vt::spectrepro-vt PROPERTIES
        IMPORTED_LOCATION "${_spectrepro_vt_shared_location}"
        INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@"
    )
    unset(_spectrepro_vt_shared_location)

    if(APPLE)
        set_target_properties(spectrepro-vt::spectrepro-vt PROPERTIES
            IMPORTED_SONAME "@rpath/@SPECTREPRO_VT_SONAME@"
            INTERFACE_LINK_DIRECTORIES "${_spectrepro_vt_libdir}"
        )
        # Ensure consumers can find the @rpath dylib at runtime
        set_property(TARGET spectrepro-vt::spectrepro-vt APPEND PROPERTY
            INTERFACE_LINK_OPTIONS "LINKER:-rpath,${_spectrepro_vt_libdir}"
        )
    elseif(WIN32)
        set_target_properties(spectrepro-vt::spectrepro-vt PROPERTIES
            IMPORTED_IMPLIB "${_spectrepro_vt_libdir}/@SPECTREPRO_VT_IMPLIB@"
        )
    else()
        set_target_properties(spectrepro-vt::spectrepro-vt PROPERTIES
            IMPORTED_SONAME "@SPECTREPRO_VT_SONAME@"
        )
    endif()
endif()

# Static library target
#
# Consumers must link transitive dependencies themselves. By default (with
# SIMD enabled): libc, libc++ (or libstdc++ on Linux), highway, and
# simdutf. Building with -Dsimd=false removes the C++ / highway / simdutf
# dependencies.
if(NOT TARGET spectrepro-vt::spectrepro-vt-static)
    add_library(spectrepro-vt::spectrepro-vt-static STATIC IMPORTED)

    set_target_properties(spectrepro-vt::spectrepro-vt-static PROPERTIES
        IMPORTED_LOCATION "${_spectrepro_vt_libdir}/@SPECTREPRO_VT_STATIC_REALNAME@"
        INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@"
    )
    if(WIN32)
        set_target_properties(spectrepro-vt::spectrepro-vt-static PROPERTIES
            INTERFACE_LINK_LIBRARIES "ntdll;kernel32"
        )
    endif()
endif()

unset(_spectrepro_vt_libdir)

check_required_components(spectrepro-vt)
